# ==============================================================================
# Job Scheduling System - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated for React Frontend)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Configuration (MySQL)
# PyMySQL will connect using: mysql+pymysql://<user>:<password>@<host>:<port>/<db>?charset=utf8mb4
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=job_scheduling_db

# Optional direct connection string (overrides individual MYSQL_* settings if provided):
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/job_scheduling_db

# Local SQLite Fallback:
# If MySQL connection fails or is not configured, the system automatically falls back
# to a local SQLite database at: SQLITE_PATH=job_scheduling.db
SQLITE_PATH=job_scheduling.db

